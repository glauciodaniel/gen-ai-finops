FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    cron ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Daily at 06:00 UTC
RUN echo "0 6 * * * cd /app && /usr/local/bin/python run_all.py >> /var/log/scrape.log 2>&1" \
    > /etc/cron.d/scrape && chmod 0644 /etc/cron.d/scrape \
    && crontab /etc/cron.d/scrape

RUN touch /var/log/scrape.log

CMD ["sh", "-c", "cron && tail -f /var/log/scrape.log"]
